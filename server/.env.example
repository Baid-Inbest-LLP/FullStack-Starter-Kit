NODE_ENV=development
PORT=5099
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/fullstack_starter_kit_db?retryWrites=true&w=majority
MONGODB_DB_NAME=fullstack_starter_kit_db
# Superadmin created on first boot when none exists.
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=super123
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=your-refresh-secret-key-change-in-production
# Optional: overrides the access-token lifetime. Defaults to 5m in dev, 15m in production.
# JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:5199
